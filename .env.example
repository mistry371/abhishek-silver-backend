# ------------------------------------------------------------------
# Abhishek Silver API — copy to .env and fill in.
# NEVER commit .env. Service-role keys and secrets stay on the server.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_PREFIX=/v1

# Comma-separated origins allowed to call the API (storefront + admin)
CORS_ORIGINS=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
# Public URL of this API (links to locally stored media)
PUBLIC_API_URL=http://localhost:4000
# Optional: storefront cache revalidation so admin edits appear immediately
STOREFRONT_REVALIDATE_URL=
STOREFRONT_REVALIDATE_SECRET=

# ---------------- Database ----------------
# Leave DATABASE_URL empty to use embedded PGlite (PostgreSQL in-process)
# stored in PGLITE_DATA_DIR — local development only.
# Supabase: Project Settings → Database → Connection string (URI).
DATABASE_URL=
PGLITE_DATA_DIR=.pglite

# ---------------- Authentication ----------------
# local    → development-only provider issuing Supabase-shaped JWTs
# supabase → Supabase Auth (email/password + phone OTP)
AUTH_PROVIDER=local
LOCAL_JWT_SECRET=replace-with-a-long-random-development-secret

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still using the legacy HS256 JWT secret.
# Projects with asymmetric signing keys are verified via JWKS automatically.
SUPABASE_JWT_SECRET=

# ---------------- File storage ----------------
# local    → files saved under ./uploads and served at /uploads
# supabase → Supabase Storage buckets
STORAGE_PROVIDER=local
SUPABASE_MEDIA_BUCKET=media
SUPABASE_PRIVATE_BUCKET=private-documents

# ---------------- Instagram feed (optional) ----------------
# Long-lived token from the Meta developer dashboard (Instagram API with Instagram Login).
# When set, the homepage shows the latest posts and reels; otherwise the posts from
# Admin → Content → Instagram. The token is renewed automatically every week.
INSTAGRAM_ACCESS_TOKEN=

# ---------------- Payments ----------------
# demo     → development gateway (no money moves)
# razorpay → Razorpay Orders API + signature verification
PAYMENT_PROVIDER=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# PAYMENT_PROVIDER=none launches without online payments (browsing, enquiries, WhatsApp).

# ---------------- Hosted start-up ----------------
# Apply migrations + essential data on start (useful on hosts without a shell, e.g. Render free)
MIGRATE_ON_START=false
# First Super Admin, created on start only when no admin exists yet
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=

# ---------------- Local seed ----------------
# Password for seeded development admin accounts (AUTH_PROVIDER=local only)
SEED_ADMIN_PASSWORD=Admin@12345
